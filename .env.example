# FastAPI settings
DATABASE_URL=sqlite+aiosqlite:///./data/eduguard.db
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
DEBUG=1

# wg-easy settings
WG_HOST=vpn.eduguard.local
WG_PASSWORD=admin
WG_PORT=51820

# Nginx and SSL settings
NGINX_HOST=localhost

# Tailscale settings
# Get your auth key from: https://login.tailscale.com/admin/settings/keys
# Generate an auth key (recommended: reusable, ephemeral, with tags if using ACLs)
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TS_HOSTNAME=eduguard
TS_STATE_DIR=./data/tailscale
